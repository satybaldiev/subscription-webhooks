{
    "name": "axel/subscription-webhooks",
    "description": "Handling Appstore and Android subscription webhooks/notifications",
    "keywords": [
        "subscription-webhooks",
        "laravel-subscription-webhooks",
        "laravel-appstore-server-notifications",
        "laravel-android-server-notifications",
        "laravel-appstore-server-webhooks",
        "laravel-android-server-webhooks",
        "laravel in app subscription webhooks",
        "laravel subscription notifications",
        "laravel subscription webhooks"
    ],
    "minimum-stability": "stable",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Axel\\SubscriptionWebhooks\\": "src/"
        },
        "files": [
            "./helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Axel\\SubscriptionWebhooks\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "ext-json": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Daniiar Satybaldiev",
            "email": "satybaldiev@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Axel\\SubscriptionWebhooks\\NotificationServiceProvider"
            ]
        }
    }
}
